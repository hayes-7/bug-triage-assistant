# GitHub
GITHUB_TOKEN=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase 直连（DDL 专用：建表 / 建索引 / 建函数）
# 格式：postgresql://postgres.<ref>:<password>@<host>.pooler.supabase.com:5432/postgres
# 备注：PostgREST（URL + anon / service_role key）不支持 DDL，故建表类操作走此连接
DATABASE_URL=

# 模型
# PRIMARY_MODEL_ID 切换即换模型（qwen-plus 为默认主模型；qwen3-max 为对比用，成本约 5-6 倍）
PRIMARY_MODEL_ID=qwen-plus
OPENAI_BASE_URL=
PRIMARY_MODEL_API_KEY=
FALLBACK_MODEL_API_KEY=

# 向量模型（独立于分诊模型：两类模型须可独立切换，且 DeepSeek 等非 OpenAI 厂商不提供 Embedding 接口）
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL_ID=
